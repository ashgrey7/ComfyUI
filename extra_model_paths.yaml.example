#Rename this to extra_model_paths.yaml and ComfyUI will load it


#config for a1111 ui
#all you have to do is change the base_path to where yours is installed
a111:
    base_path: D:\ComfyUI

    checkpoints: D:\ComfyUI\models
    configs: D:\ComfyUI\models\configs
    vae: D:\ComfyUI\models\vae
    loras: |
         D:\ComfyUI\models\loras
         D:\ComfyUI\models\loras
    upscale_models: |
                  D:\ComfyUI\models\upscale_models
    embeddings: D:\ComfyUI\models\embeddings
    hypernetworks: D:\ComfyUI\models\hypernetworks
    controlnet: D:\ComfyUI\models\controlnet

